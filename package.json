{
  "name": "switchboard",
  "version": "0.2.1",
  "private": true,
  "description": "Agent gateway: messages from Slack, the CLI, HTTP, or MCP are routed to agents that answer, review, and ship code on any model provider, executing in sandboxes you control",
  "license": "Apache-2.0",
  "homepage": "https://github.com/coreplanelabs/switchboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreplanelabs/switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/coreplanelabs/switchboard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "workspaces": [
    "web",
    "docs",
    "deploy/cloudflare",
    "deploy/cloudflare-memory",
    "deploy/cloudflare-resident",
    "deploy/cloudflare-sandbox",
    "deploy/cloudflare-docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "verify": "npm run verify:root && npm run verify --workspaces --if-present && npm run check:site",
    "verify:root": "npm run check:consistency && npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:dist",
    "check:consistency": "npm run check:lockfile && npm run check:sandbox-pair && npm run skills:check && npm run licenses:check && npm run docs:check && npm run specs:check",
    "ci:gate": "node scripts/ci-gate.mjs",
    "fix": "npm run docs:gen && npm run skills:sync && npm run lint:fix && npm run format",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:sandbox-pair": "node scripts/check-sandbox-pair.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dist": "npm run build && node scripts/check-dist.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:image": "docker build --quiet .",
    "skills:sync": "tsx scripts/skills-sync.ts",
    "skills:check": "tsx scripts/skills-sync.ts --check",
    "licenses:check": "node scripts/licenses-check.mjs",
    "docs:gen": "tsx scripts/docs-gen.ts",
    "docs:check": "tsx scripts/docs-gen.ts --check",
    "specs:check": "node scripts/specs-check.mjs",
    "docs:changed": "node scripts/docs-changed.mjs",
    "deploy:targets": "node scripts/deploy-targets.mjs",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "web:preview": "tsx scripts/web-preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@slack/bolt": "^5.1.0",
    "e2b": "^2.46.1",
    "mdast-util-from-markdown": "^2.0.3",
    "undici": "^8.10.2",
    "yaml": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
