{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable Slack bot that routes requests to agents (coding, review, general) across pluggable inference providers",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent-env-bootstrap": "tsx src/agentEnv/bootstrapCli.ts",
    "deploy:all": "tsx src/deploy/deployAllCli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@slack/bolt": "^4.2.0",
    "e2b": "^2.39.0",
    "undici": "^8.10.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
