{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "Agent gateway: messages from Slack, the CLI, HTTP, or MCP are routed to agents that answer, review, and ship code on any model provider, executing in sandboxes you control",
  "license": "Apache-2.0",
  "homepage": "https://github.com/coreplanelabs/switchboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreplanelabs/switchboard.git"
  },
  "bugs": {
    "url": "https://github.com/coreplanelabs/switchboard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "skills:sync": "tsx scripts/skills-sync.ts",
    "skills:check": "tsx scripts/skills-sync.ts --check",
    "licenses:check": "node scripts/licenses-check.mjs",
    "docs:gen": "tsx scripts/docs-gen.ts",
    "docs:check": "tsx scripts/docs-gen.ts --check",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "web:preview": "tsx scripts/web-preview.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@slack/bolt": "^4.2.0",
    "e2b": "^2.46.1",
    "mdast-util-from-markdown": "^2.0.3",
    "undici": "^8.10.2",
    "yaml": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
