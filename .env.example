# Slack (Socket Mode app)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Providers (referenced by apiKeyEnv in config.yaml)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Sandboxed execution (execution.type: e2b in config.yaml)
E2B_API_KEY=e2b_...

# GitHub machine-account token for the coding/review agents (gh + git).
# Use a fine-grained PAT scoped to only the repos the bot should touch.
GH_TOKEN=github_pat_...
