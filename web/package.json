{
  "name": "switchboard-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run licenses:check && npm run build",
    "licenses:check": "node ../scripts/licenses-check.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@pierre/diffs": "1.5.2",
    "@vueuse/core": "^15.0.0",
    "emojibase-data": "18.0.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.143",
    "@iconify-json/simple-icons": "^1.2.100",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.13"
  }
}
