{
  "name": "switchboard-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run licenses:check && npm run build",
    "licenses:check": "node ../scripts/licenses-check.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "@vueuse/core": "^14.4.0",
    "diff2html": "^3.4.56",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
