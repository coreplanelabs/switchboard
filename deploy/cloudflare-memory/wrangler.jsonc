{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard-memory",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // coreplane-infra account — same as the bot, sandbox, and resident Workers
  "account_id": "3c7b28f23cc93f09e77bb0a9ffcb7e6f",
  // Reachable only with the MEMORY_TOKEN bearer secret (plus an unauthenticated
  // GET /healthz wake ping). Custom domain on the coreplanelabs.dev zone so the
  // bot config (memory.worker.baseUrl) has a stable URL.
  "workers_dev": false,
  "routes": [{ "pattern": "switchboard-memory.coreplanelabs.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "durable_objects": {
    // One MemoryDO per scopeKey (the DO name IS the scope key, e.g.
    // "org:coreplanelabs") — the scope partition is the object boundary, so a
    // scope's rows live in one SQLite database and cross-scope reads are
    // impossible by construction.
    "bindings": [
      { "name": "MEMORY", "class_name": "MemoryDO" },
      // One FrictionDO per ledger key (`friction:<repo>`): the durable friction
      // ledger behind `friction propose` (#84, features/self-improvement.md).
      { "name": "FRICTION", "class_name": "FrictionDO" },
      // ONE ScheduleDO (named "schedules"): every cron firing the bot's Worker
      // shim makes, for the /runs Scheduled panel (#244, features/live-view.md).
      { "name": "SCHEDULES", "class_name": "ScheduleDO" },
      // One RunHistoryDO per store key (`runs:default`): persistent run history
      // (#157, features/run-history.md) — runs + run_events + the retention policy.
      { "name": "RUNS", "class_name": "RunHistoryDO" }
    ]
  },
  // SQLite-backed DOs (durable across restarts — AGENTS.md invariant 6).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MemoryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["FrictionDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ScheduleDO"] },
    { "tag": "v4", "new_sqlite_classes": ["RunHistoryDO"] }
  ]
}
