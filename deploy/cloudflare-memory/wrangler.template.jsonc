{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{script}}",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // The installation's Cloudflare account (deploy/profile.json `account`) — every Worker deploys to it.
  "account_id": "{{account}}",
  // Reachable only with the MEMORY_TOKEN bearer secret (plus an unauthenticated
  // GET /healthz wake ping). Custom domain on the installation's zone so the
  // bot config (memory.worker.baseUrl) has a stable URL.
  "workers_dev": false,
  "routes": [{ "pattern": "{{hostname}}", "custom_domain": true }],
  "observability": { "enabled": true },
  "durable_objects": {
    // One MemoryDO per scopeKey (the DO name IS the scope key, e.g.
    // "org:<organization>") — the scope partition is the object boundary, so a
    // scope's rows live in one SQLite database and cross-scope reads are
    // impossible by construction.
    "bindings": [
      { "name": "MEMORY", "class_name": "MemoryDO" },
      // ONE ScheduleDO (named "schedules"): every cron firing the bot's Worker
      // shim makes, for the /runs Scheduled panel (docs/reference/specs/live-view.md).
      { "name": "SCHEDULES", "class_name": "ScheduleDO" },
      // One RunHistoryDO per store key (`runs:default`): persistent run history
      // (docs/reference/specs/run-history.md) — runs + run_events + the retention policy.
      { "name": "RUNS", "class_name": "RunHistoryDO" },
      // ONE ConfigDO (named "config"): the bot's runtime config documents — the
      // chat-set `overrides` (docs/reference/specs/routing-and-config.md item 12) — versioned.
      { "name": "CONFIG", "class_name": "ConfigDO" },
      // One RunTranscriptDO per LIVE run (the DO name is the run id): the raw
      // transcript a resumed run continues from (docs/reference/specs/run-history.md item
      // 32). Kept apart from the history object so transcript bytes never queue
      // behind an admission decision; cleared at finish.
      { "name": "RUN_TRANSCRIPTS", "class_name": "RunTranscriptDO" },
      // ONE DeliveryDO (named "delivery"): the delivery page's snapshot per
      // repository — the merged pull requests' facts over the window, one row
      // each, and when they were read (docs/reference/specs/delivery.md item 10).
      { "name": "DELIVERY", "class_name": "DeliveryDO" },
      // ONE CostsSnapshotDO (named "costs"): the installation's costs snapshot —
      // both billing sources' rows over the costs page's widest range and the run
      // history's per-user usage, one row per part, replaced whole on every take
      // (docs/reference/specs/costs.md item 6).
      { "name": "COSTS", "class_name": "CostsSnapshotDO" },
      // One SessionLogDO per session — a thread and an agent (the DO name is
      // `<threadKey>:<agent>`): the transcript rows of every run of the
      // session, a full-text index over them, and the notepad
      // (docs/reference/specs/session-log.md). Kept after a run finishes; the
      // retention sweep drops it once its last kept run is gone and no run is
      // live on the thread. Runs claimed before it existed still finish on
      // RunTranscriptDO, which stays bound until no such row is live.
      { "name": "SESSION_LOGS", "class_name": "SessionLogDO" }
    ]
  },
  // The bot shim's ship coordinator Workflow, bound across scripts by the bot's
  // script name (docs/reference/specs/run-history.md item 47): `RunHistoryDO.finish`
  // sends it `run finished:<runId>` for a record carrying `parentInstanceId`.
  // The name is the bot's own Workflow name (`<bot script>-ship-coordinator`,
  // deploy/cloudflare/wrangler.template.jsonc). The class is deployed with the
  // bot, which deploys after this Worker — so this binding lands one release
  // after the class did, never in the same one.
  // The bot Worker, for the plane's effect push (record 0064, "Where it
  // lives"): committed effects POST to the bot's bearer-gated /plane/effects,
  // which forwards them to the container. A push that fails is not retried by
  // a timer — the effect rides the next heartbeat or reclaim-sweep answer.
  "services": [{ "binding": "BOT", "service": "{{bot.script}}" }],
  "workflows": [
    {
      "name": "{{bot.script}}-ship-coordinator",
      "binding": "SHIP_COORDINATOR",
      "class_name": "ShipCoordinator",
      "script_name": "{{bot.script}}"
    }
  ],
  // {{#if metrics}}
  // The run-metrics dataset (docs/reference/specs/run-metrics.md): where RunHistoryDO
  // writes a turned-final run's point, bound only when the deployment profile names a
  // dataset (`metrics.dataset`) — nothing is created ahead of the deploy; the platform
  // creates the dataset on first write. Without it the Worker deploys without the
  // binding and writes no points.
  "analytics_engine_datasets": [{ "binding": "RUN_METRICS", "dataset": "{{metrics.dataset}}" }],
  // The dataset's name beside its binding (rendered together): /healthz `features`
  // says `runMetrics:<dataset>` from it, so the bot's boot probe can compare the
  // name its own config carries with the one this deploy bound.
  "vars": { "RUN_METRICS_DATASET": "{{metrics.dataset}}" },
  // {{/if}}
  // SQLite-backed DOs (durable across restarts — AGENTS.md invariant 6).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MemoryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["FrictionDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ScheduleDO"] },
    { "tag": "v4", "new_sqlite_classes": ["RunHistoryDO"] },
    { "tag": "v5", "new_sqlite_classes": ["ConfigDO"] },
    { "tag": "v6", "new_sqlite_classes": ["RunTranscriptDO"] },
    // The friction ledger is read from run history (RunHistoryDO carries every
    // run's diagnosis); the FrictionDO that once mirrored those diagnoses is
    // retired with its rows — docs/reference/specs/self-improvement.md item 1.
    { "tag": "v7", "deleted_classes": ["FrictionDO"] },
    { "tag": "v8", "new_sqlite_classes": ["DeliveryDO"] },
    { "tag": "v9", "new_sqlite_classes": ["SessionLogDO"] },
    { "tag": "v10", "new_sqlite_classes": ["CostsSnapshotDO"] }
  ]
}
