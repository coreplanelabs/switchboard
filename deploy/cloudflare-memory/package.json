{
  "name": "switchboard-memory-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node ../bin/build-stamp.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "npm --prefix ../.. run --silent deploy:gen && npm run typecheck && npm test",
    "typegen": "wrangler types",
    "tail": "wrangler tail",
    "secrets": "npm --prefix ../.. run --silent cli -- deploy secrets memory"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.3",
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.0"
  }
}
