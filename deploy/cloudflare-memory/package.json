{
  "name": "@coreplane/switchboard-memory-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node ../bin/build-stamp.mjs && npm run wake",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "typegen": "wrangler types",
    "tail": "wrangler tail switchboard-memory",
    "secrets": "node ../bin/put-secrets.mjs memory",
    "wake": "curl -s -o /dev/null -w 'memory worker awake: HTTP %{http_code}\\n' --max-time 60 https://switchboard-memory.coreplanelabs.dev/healthz"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
