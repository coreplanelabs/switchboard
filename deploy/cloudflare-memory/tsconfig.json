{
  // Scoped config so `npm run typecheck` here checks worker.ts (and the shared
  // src/core/memory engine it imports by relative path) — without it, tsc
  // silently falls back to the repo-root tsconfig, which excludes this dir.
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers/types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "worker.ts",
    "worker.test.ts",
    "schedules.test.ts",
    "backgroundTasks.ts",
    "backgroundTasks.test.ts",
    "testDiagnostics.ts",
    "testDiagnosticsProtocol.ts",
    "testDiagnosticsReporter.ts",
    "testSetup.ts",
    "vitest.config.ts",
    "test-env.d.ts"
  ]
}
