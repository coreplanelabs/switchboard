{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // coreplane-infra account — same as terrateam (see coreplanelabs/infrastructure)
  "account_id": "3c7b28f23cc93f09e77bb0a9ffcb7e6f",
  // Custom domain on the coreplanelabs.dev zone (same account as the resident's
  // switchboard-resident.coreplanelabs.dev). Slack traffic is the container's
  // outbound websocket; the inbound HTTP surface here is the cron keep-alive +
  // the authed ingress/MCP endpoints + the live-view dashboard (/runs).
  // workers.dev is DISABLED: the /runs dashboard must sit behind Cloudflare
  // Access (SSO), and Access can only front a real zone domain — leaving the
  // workers.dev URL up would expose an un-SSO'd copy of /runs.
  "workers_dev": false,
  "routes": [{ "pattern": "switchboard.coreplanelabs.dev", "custom_domain": true }],
  // Non-secret, deploy-constant: the public base for live-view links. The
  // dispatcher (in the container) reads process.env.PUBLIC_BASE_URL to put the
  // /runs/<id>?t=… link on the status card; worker.ts forwards it into envVars.
  "vars": { "PUBLIC_BASE_URL": "https://switchboard.coreplanelabs.dev" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "containers": [
    {
      "class_name": "SwitchboardServer",
      // Builds ../../Dockerfile (the same image docker-compose uses)
      "image": "../../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SWITCHBOARD", "class_name": "SwitchboardServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SwitchboardServer"] }],
  // Keep-alive every minute: this is also what RESTARTS the container after
  // a deploy rollout or platform maintenance — the interval bounds the deaf
  // window (Socket Mode events during downtime are lost, never redelivered).
  "triggers": { "crons": ["* * * * *"] }
}
