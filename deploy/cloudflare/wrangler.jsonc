{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // coreplane-infra account — same as terrateam (see coreplanelabs/infrastructure)
  "account_id": "3c7b28f23cc93f09e77bb0a9ffcb7e6f",
  // No routes: Slack traffic is the container's outbound websocket; the only
  // inbound path is the cron keep-alive, which stays internal.
  // workers.dev URL enabled so deploys can wake the container immediately
  // (the fetch handler only proxies to the container's health endpoint).
  "workers_dev": true,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "containers": [
    {
      "class_name": "SwitchboardServer",
      // Builds ../../Dockerfile (the same image docker-compose uses)
      "image": "../../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SWITCHBOARD", "class_name": "SwitchboardServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SwitchboardServer"] }],
  // Keep-alive every minute: this is also what RESTARTS the container after
  // a deploy rollout or platform maintenance — the interval bounds the deaf
  // window (Socket Mode events during downtime are lost, never redelivered).
  "triggers": { "crons": ["* * * * *"] }
}
