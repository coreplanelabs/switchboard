{
  "name": "@coreplane/switchboard-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node preflight.mjs && node write-build.mjs && wrangler deploy && npm run wake",
    "preflight": "node preflight.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typegen": "wrangler types",
    "tail": "wrangler tail switchboard",
    "secrets": "node ../bin/put-secrets.mjs bot",
    "wake": "curl -s -o /dev/null -w 'container awake: HTTP %{http_code}\\n' --max-time 180 https://switchboard.coreplanelabs.dev/healthz"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}