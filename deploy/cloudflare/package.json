{
  "name": "@coreplane/switchboard-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node preflight.mjs && node write-build.mjs && wrangler deploy",
    "preflight": "node preflight.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typegen": "wrangler types",
    "tail": "wrangler tail",
    "secrets": "npm --prefix ../.. run --silent cli -- deploy secrets bot"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
