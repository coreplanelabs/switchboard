{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard-linear-local",
  "main": "linear.local.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "vars": { "PUBLIC_BASE_URL": "http://localhost:8080" },
  "durable_objects": {
    "bindings": [{ "name": "LINEAR_STATE", "class_name": "LinearState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LinearState"] }]
}
