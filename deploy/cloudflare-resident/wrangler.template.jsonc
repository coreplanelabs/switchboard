{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{script}}",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // @cloudflare/sandbox@next needs Node builtins (same as the SDK's own examples).
  "compatibility_flags": ["nodejs_compat"],
  // The installation's Cloudflare account (deploy/profile.json `account`) — every Worker deploys to it.
  "account_id": "{{account}}",
  // Reachable only with the RESIDENT_ADMIN_TOKEN / RESIDENT_OPERATOR_TOKEN
  // bearer secrets (plus an unauthenticated GET /healthz wake ping). Custom
  // domain on the installation's zone so the bot config has a stable URL.
  "workers_dev": false,
  "routes": [{ "pattern": "{{hostname}}", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    // The state Worker (deploy/cloudflare-memory/): where scheduled() records
    // each resident-watchdog firing. Public URL — a var, not a
    // secret; the bearer is the MEMORY_TOKEN secret (deploy/secrets.manifest.json).
    // A profile without a memory Worker renders no var: firings go unrecorded.
    // {{#if urls.stateWorkerUrl}}
    "STATE_WORKER_URL": "{{urls.stateWorkerUrl}}",
    // {{/if}}
    // Presigned snapshot transfers (docs/reference/specs/resident-repos.md item 61):
    // with these two vars AND the R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
    // secrets (deploy/secrets.manifest.json) present, the container moves
    // archive bytes itself over presigned R2 URLs and the Durable Object stays
    // out of the data path; any one absent → the SDK's local-bucket mode.
    // BACKUP_BUCKET_NAME MUST equal the BACKUP_BUCKET
    // binding's bucket below — the SDK signs URLs for this name, the offboard
    // sweep deletes through the binding. Public config, not secrets.
    "CLOUDFLARE_ACCOUNT_ID": "{{account}}",
    "BACKUP_BUCKET_NAME": "{{script}}-cache"
  },
  "containers": [
    {
      "class_name": "ResidentDO",
      // The profile's image mode decides (src/deploy/images.ts): `build` renders
      // ./Dockerfile, built by wrangler at deploy time; `registry` renders the
      // release's published image as copied into this account's registry by
      // `deploy images`. The Dockerfile extends docker.io/cloudflare/sandbox:<version>,
      // whose tag MUST match the @cloudflare/sandbox version in package.json
      // EXACTLY (no 'latest' tag exists) — bump both together.
      "image": "{{image}}",
      // Custom 4 vCPU / 12 GiB / 20 GB — the platform's custom-type ceiling
      // (the same shape as standard-4, kept in object form so the sizing test
      // can read it). This ONE type is every resident's container (one DO per
      // repo, one container class), so it is sized for the largest onboarded
      // repo and for 16 threads sharing it. The CPU is the decision now: with
      // one vCPU every thread's test run and the refresh cycle's own install
      // shared a single core (the fifty-concurrent-runs plan, D6). Memory
      // follows the CPU (Cloudflare requires >=3 GiB per vCPU → 12 GiB), and
      // the disk follows the memory (<=2 GB per GiB → 20 GB). The disk
      // arithmetic is over measured parts, checked by instanceSizing.test.ts
      // against this file: the resident of a large monorepo filled the
      // original 8 GB in 45 min (provision, one thread attached 42 min later,
      // ENOSPC 6 min after that). Measured inside the resident
      // (docs/reference/specs/resident-repos.md item 55): image 552 MB + mirror 380
      // + warm checkout 2772 (history 380, tree 94, pnpm node_modules 2298) +
      // the reserve the attach admission holds back (snapshot staging + a
      // 1 GiB floor, 2965) = 6669 MB base; a hardlinked thread tree 555 MB; a
      // thread whose lockfile differs 2853 MB; 20 000 MB mounts as ~18 858 MB
      // usable → 16 hardlinked + 1 installing trees (or 12 + 2) fit; the
      // pool's 16 + 2 does not fit even this ceiling, so the disk stays a
      // BUDGET (residentDiskBudget.ts): the next tree past it is refused
      // `disk-pressure` and runs cold, never ENOSPC. The pnpm store holds no
      // second copy of the deps (measured).
      //
      // Cost: vCPU bills on ACTIVE use only; memory and disk bill on the
      // provisioned size while awake, and a resident is effectively always-on
      // (10-min refresh alarm < 20m sleepAfter) — about $83/mo provisioned per
      // resident (memory ~$79 + disk ~$4) vs ~$55 at 8 GiB / 16 GB, plus vCPU
      // when the cores are busy (up to ~$210/mo with all four pinned, which
      // under load they are meant to be). History: standard-1 (½ vCPU / 4 GiB
      // / 8 GB) → 1 vCPU (a resident pinned at 100% of ½ vCPU, memory fine) →
      // 8 GiB for the 16 GB of disk it unlocks → 4 vCPU / 12 GiB / 20 GB for
      // 16 concurrent seats. That monorepo's console build asks for a 16 GB
      // node heap, so if `build` ever becomes a real command this is still
      // not the ceiling. Custom-type constraints: whole vCPUs 1-4, >=3 GiB per
      // vCPU, <=2 GB disk per GiB, at most 12 GiB / 20 GB. (The thread-sandbox
      // Worker is the predefined standard-4 — the same 4 vCPU / 12 GiB / 20 GB,
      // reached from the other side: one cold thread must be able to typecheck
      // a large monorepo alone — and it is awake only for one run.)
      "instance_type": { "vcpu": 4, "memory_mib": 12288, "disk_mb": 20000 },
      // Platform ceiling only. The enforced cap is RESIDENT_CAP (6) in
      // worker.ts — deliberately below this so an onboard is always refused
      // atomically by the registry, never by a platform scheduling failure.
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      // One ResidentDO (Sandbox subclass = container) per onboarded resource;
      // the DO name IS the resource id ("repo:<slug>").
      { "name": "RESIDENT", "class_name": "ResidentDO" },
      // Singleton registry: onboarded set + command table + cap enforcement.
      { "name": "REGISTRY", "class_name": "ResidentRegistryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResidentDO", "ResidentRegistryDO"] }],
  // Resident cache + snapshots. The binding name BACKUP_BUCKET is load-bearing:
  // metadata reads and the offboard sweep go through it, and the SDK's
  // local-bucket mode (createBackup({ localBucket: true })) moves the archive
  // bytes through it too — via the Durable Object, which is what put a 128 MB
  // isolate in the data path of a 1.16 GB restore (item 61). Production
  // mode is presigned: the CLOUDFLARE_ACCOUNT_ID / BACKUP_BUCKET_NAME vars
  // above plus the R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY secrets let the
  // container move the bytes itself; with any of the four absent the Worker
  // falls back to local mode and says so on /healthz. The bucket is named after
  // this Worker's script (`<script>-cache`), so two installations on one
  // account never share one — and BACKUP_BUCKET_NAME must say the same name.
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "{{script}}-cache" }],
  // Watchdog cadence: every 10 minutes, strictly BELOW the container
  // sleep window (SLEEP_AFTER = "20m" in worker.ts) so a healthy resident is
  // re-warmed before the platform can ever sleep it. Invariant: watchdog/alarm
  // cadence < sleepAfter — bump the two together. This list must equal the
  // `resident` entries of the schedule registry (src/core/schedules.ts) — a
  // unit test enforces it; change the registry first.
  "triggers": { "crons": ["*/10 * * * *"] }
}
