{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchboard-resident",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // @cloudflare/sandbox@next needs Node builtins (same as the SDK's own examples).
  "compatibility_flags": ["nodejs_compat"],
  // coreplane-infra account — same as terrateam and the switchboard bot
  "account_id": "3c7b28f23cc93f09e77bb0a9ffcb7e6f",
  // Reachable only with the RESIDENT_ADMIN_TOKEN / RESIDENT_OPERATOR_TOKEN
  // bearer secrets (plus an unauthenticated GET /healthz wake ping). Custom
  // domain on the coreplanelabs.dev zone (same account) so the bot config has
  // a stable URL.
  "workers_dev": false,
  "routes": [{ "pattern": "switchboard-resident.coreplanelabs.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  "vars": {
    // The state Worker (deploy/cloudflare-memory/): where scheduled() records
    // each resident-watchdog firing (#244/#307). Public URL — a var, not a
    // secret; the bearer is the MEMORY_TOKEN secret (deploy/secrets.manifest.json).
    "STATE_WORKER_URL": "https://switchboard-memory.coreplanelabs.dev"
  },
  "containers": [
    {
      "class_name": "ResidentDO",
      // Extends docker.io/cloudflare/sandbox:<version>. The image tag MUST
      // match the @cloudflare/sandbox version in package.json EXACTLY (no
      // 'latest' tag exists) — bump both together.
      "image": "./Dockerfile",
      // Custom 1 vCPU / 8 GiB / 16 GB. This ONE type is every resident's
      // container (one DO per repo, one container class), so it is sized for
      // the largest onboarded repo — and the disk is the binding constraint,
      // not memory: Cloudflare caps disk at 2 GB per GiB of memory, so 16 GB
      // of disk requires 8 GiB. The sizing is arithmetic over measured parts,
      // checked by instanceSizing.test.ts against this file: 2026-09-04 the
      // nominal resident filled the previous 8 GB in 45 min (provision 21:02Z,
      // one thread attached 21:44Z, ENOSPC at 21:50Z) — nominal at that day's
      // main measures 357 MB of history, a 75 MB tree and 2.1 GB of pnpm
      // node_modules; a resident holds the mirror, the warm checkout, and one
      // FULL clone per active thread (deps hardlinked, but a thread whose
      // lockfile differs installs its own 2.1 GB under its own user's pnpm
      // store), plus the ~0.5 GB OS image on the same filesystem and the
      // refresh snapshot in flight. Three deps-installing threads: ~12.7 GB.
      // 8 GB was the platform default, never a budget.
      //
      // Cost: vCPU bills on ACTIVE use only; memory and disk bill on the
      // provisioned size while awake, and a resident is effectively always-on
      // (10-min refresh alarm < 20m sleepAfter) — memory-only ~$52/mo at
      // 8 GiB vs ~$26/mo at 4 GiB, per resident. History: standard-1 (½ vCPU /
      // 4 GiB / 8 GB) → 2026-08-29 doubled CPU (a resident pinned at 100% of
      // ½ vCPU, memory fine) → 2026-09-04 doubled memory for the disk it
      // unlocks. nominal's console build asks for a 16 GB node heap, so if
      // `build` ever becomes a real command this is still not the ceiling.
      // Custom-type constraints: whole vCPUs 1-4, >=3 GiB per vCPU, <=2 GB
      // disk per GiB. (The thread-sandbox Worker is standard-3 — it lives only
      // for one run.)
      "instance_type": { "vcpu": 1, "memory_mib": 8192, "disk_mb": 16000 },
      // Platform ceiling only. The enforced cap is RESIDENT_CAP (6) in
      // worker.ts — deliberately below this so an onboard is always refused
      // atomically by the registry, never by a platform scheduling failure.
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [
      // One ResidentDO (Sandbox subclass = container) per onboarded resource;
      // the DO name IS the resource id ("repo:<slug>").
      { "name": "RESIDENT", "class_name": "ResidentDO" },
      // Singleton registry: onboarded set + command table + cap enforcement.
      { "name": "REGISTRY", "class_name": "ResidentRegistryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResidentDO", "ResidentRegistryDO"] }],
  // Resident cache + snapshots. The binding name BACKUP_BUCKET is load-bearing:
  // the Sandbox SDK's createBackup({ localBucket: true }) resolves exactly this
  // binding from the DO's env (verified live on 0.13.0-next.751.1 — a backup +
  // restore round-trip works in production with only this binding, no R2 API
  // keys). Non-localBucket (presigned) backups would additionally need the
  // CLOUDFLARE_R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY /
  // BACKUP_BUCKET_NAME secrets.
  "r2_buckets": [{ "binding": "BACKUP_BUCKET", "bucket_name": "switchboard-resident-cache" }],
  // Watchdog cadence (KTD4): every 10 minutes, strictly BELOW the container
  // sleep window (SLEEP_AFTER = "20m" in worker.ts) so a healthy resident is
  // re-warmed before the platform can ever sleep it. Invariant: watchdog/alarm
  // cadence < sleepAfter — bump the two together. This list must equal the
  // `resident` entries of the schedule registry (src/core/schedules.ts) — a
  // unit test enforces it; change the registry first.
  "triggers": { "crons": ["*/10 * * * *"] }
}
