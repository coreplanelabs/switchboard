{
  "name": "@coreplane/switchboard-resident-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node preflight.mjs && node ../bin/build-stamp.mjs && npm run wake",
    "preflight": "node preflight.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "typegen": "wrangler types",
    "tail": "wrangler tail switchboard-resident",
    "secrets": "node ../bin/put-secrets.mjs resident",
    "wake": "curl -s -o /dev/null -w 'resident worker awake: HTTP %{http_code}\\n' --max-time 180 https://switchboard-resident.coreplanelabs.dev/healthz"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.13.0-next.751.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.120.1"
  }
}
