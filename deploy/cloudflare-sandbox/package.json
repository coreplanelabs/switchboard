{
  "name": "@coreplane/switchboard-sandbox-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typegen": "wrangler types",
    "tail": "wrangler tail switchboard-sandbox",
    "secrets": "while read -r name; do [ -z \"$name\" ] && continue; echo \"--- $name ---\"; wrangler secret put \"$name\"; done < secrets.txt"
  },
  "dependencies": { "@cloudflare/sandbox": "^0.3.0" },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.120.1"
  }
}
