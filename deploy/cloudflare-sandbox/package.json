{
  "name": "@coreplane/switchboard-sandbox-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node ../bin/build-stamp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck",
    "dev": "wrangler dev",
    "typegen": "wrangler types",
    "tail": "wrangler tail switchboard-sandbox",
    "secrets": "node ../bin/put-secrets.mjs sandbox"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.13.0-next.751.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  }
}
