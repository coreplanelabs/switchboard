{
  "name": "@coreplane/switchboard-sandbox-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy": "node ../bin/build-stamp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm --prefix ../.. run --silent deploy:gen && npm run typecheck",
    "dev": "wrangler dev",
    "typegen": "wrangler types",
    "tail": "wrangler tail",
    "secrets": "npm --prefix ../.. run --silent cli -- deploy secrets sandbox"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.129.0"
  }
}
