{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{script}}",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // @cloudflare/sandbox 0.12.x imports Node built-ins (wrangler's dry run names
  // sandbox-*.js and warns the Worker "may throw errors at runtime" without
  // this); the resident Worker on the 0.13 line carries the same flag.
  "compatibility_flags": ["nodejs_compat"],
  // The installation's Cloudflare account (deploy/profile.json `account`) — every Worker deploys to it.
  "account_id": "{{account}}",
  // Reachable only with the SANDBOX_TOKEN bearer secret. Custom domain on the
  // installation's zone so the bot config has a stable URL.
  "workers_dev": false,
  "routes": [{ "pattern": "{{hostname}}", "custom_domain": true }],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "SwitchboardSandbox",
      // The profile's image mode decides (src/deploy/images.ts): `build` renders
      // ./Dockerfile (on the @cloudflare/sandbox base image), built by wrangler
      // at deploy time; `registry` renders the release's published image as
      // copied into this account's registry by `deploy images`.
      "image": "{{image}}",
      // standard-4 = 4 vCPU / 12 GiB RAM / 20 GB disk — the largest predefined
      // type; a custom type tops out at the same 4 vCPU / 12 GiB / 20 GB. The
      // cold path clones + installs + checks a whole repo per thread with
      // nothing warm, so the size is set by the largest single command a cold
      // thread must be able to run, not by the typical one: a large monorepo's
      // typecheck needs more than 8 GiB (its own CI notes put the root program
      // near 8 GB and each sub-program near 4 GB), and the previous standard-3
      // (2 vCPU / 8 GiB / 16 GB; a live probe read nproc 2, 8189 MiB, 15 GB on
      // /) could not run it at all. "basic" (1 GiB) died running a repo's test
      // suite during a cold review (vitest forks per vCPU). Cost is per AWAKE
      // instance and a sandbox sleeps after 5 idle minutes (SANDBOX_SLEEP_AFTER),
      // so the step is paid per active run-hour: 12 GiB against 8 of memory,
      // and vCPU only while the cores are busy (docs/reference/specs/execution.md
      // item 16).
      "instance_type": "standard-4",
      // The fleet's ceiling on AWAKE per-thread sandboxes; the next thread past
      // it waits (docs/reference/specs/execution.md item 14). Billing is per awake
      // instance, so a higher ceiling costs nothing while instances sleep, and
      // the account has ~15x headroom on the containers limits (6 TiB memory /
      // 1500 vCPU against 25 × 12 GiB = 300 GiB, ~20x, and 25 × 4 = 100 vCPU,
      // 15x — the vCPU line is the tighter one). Seen live: thirteen cold
      // runs in 45 min exhausted the previous ceiling of 10 and a review
      // aborted in 33 s reading the wait as a dead sandbox.
      "max_instances": 25,
      // Replace the old-image instances in ONE wave on a deploy, not the
      // platform's default [10, 100] with minutes between the waves. A Worker
      // and its image deploy as two artifacts, and until the rollout finishes
      // the NEW Worker code can be handed an instance still on the PREVIOUS
      // image: seen live, a review's thread created 111 s after a Worker
      // upload landed on a 0.3.7 container under the 0.12.9 SDK and every
      // command failed for 90 s. In-flight commands on old
      // instances die in any rollout mode (each old instance is SIGTERMed
      // eventually; the grace period is already 0) — one wave only moves that
      // moment earlier, and shrinks the window a new thread can fall into
      // from minutes to seconds (docs/reference/specs/execution.md item 6).
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Sandbox", "class_name": "SwitchboardSandbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SwitchboardSandbox"] }]
}
