{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{script}}",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  // @cloudflare/sandbox 0.12.x imports Node built-ins (wrangler's dry run names
  // sandbox-*.js and warns the Worker "may throw errors at runtime" without
  // this); the resident Worker on the 0.13 line carries the same flag.
  "compatibility_flags": ["nodejs_compat"],
  // The installation's Cloudflare account (deploy/profile.json `account`) — every Worker deploys to it.
  "account_id": "{{account}}",
  // Reachable only with the SANDBOX_TOKEN bearer secret. Custom domain on the
  // installation's zone so the bot config has a stable URL.
  "workers_dev": false,
  "routes": [{ "pattern": "{{hostname}}", "custom_domain": true }],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "SwitchboardSandbox",
      // @cloudflare/sandbox ships its own container image; see the Sandbox
      // docs for the current image reference if this needs pinning.
      "image": "./Dockerfile",
      // standard-3 = 8 GiB RAM / 16 GB disk. "basic" (1 GiB) died running a
      // repo's test suite during a cold review (vitest forks per vCPU); the
      // cold path clones + installs + tests a whole repo per thread.
      "instance_type": "standard-3",
      // The fleet's ceiling on AWAKE per-thread sandboxes; the next thread past
      // it waits (features/execution.md item 14). Billing is per awake
      // instance, so a higher ceiling costs nothing while instances sleep, and
      // the account has ~150x headroom on the containers limits (6 TiB memory /
      // 1500 vCPU against 25 × 8 GiB / 25 × 2 vCPU). 2026-09-07: thirteen cold
      // runs in 45 min exhausted the previous 10 and the #525 review aborted in
      // 33 s reading the wait as a dead sandbox.
      "max_instances": 25,
      // Replace the old-image instances in ONE wave on a deploy, not the
      // platform's default [10, 100] with minutes between the waves. A Worker
      // and its image deploy as two artifacts, and until the rollout finishes
      // the NEW Worker code can be handed an instance still on the PREVIOUS
      // image: 2026-09-07 (#569) the #520 review's thread, created 111 s
      // after the 0.4.0 upload, landed on a 0.3.7 container under the 0.12.9
      // SDK and every command failed for 90 s. In-flight commands on old
      // instances die in any rollout mode (each old instance is SIGTERMed
      // eventually; the grace period is already 0) — one wave only moves that
      // moment earlier, and shrinks the window a new thread can fall into
      // from minutes to seconds (features/execution.md item 6).
      "rollout_step_percentage": 100
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Sandbox", "class_name": "SwitchboardSandbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SwitchboardSandbox"] }]
}
