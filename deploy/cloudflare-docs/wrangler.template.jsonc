{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{script}}",
  "compatibility_date": "2026-08-01",
  // The installation's Cloudflare account (deploy/profile.json `account`) — every Worker deploys to it.
  "account_id": "{{account}}",
  // ASSETS ONLY: no `main`, so there is no Worker script, no Durable Object,
  // and no container. Nothing here can be mid-rollout or draining, which is
  // exactly why CI may deploy it on every docs change, while the four runtime
  // Workers deploy on the release, preflighted and in order (AGENTS.md,
  // docs/reference/specs/docs-site.md, docs/reference/specs/release-and-deploy.md).
  "assets": {
    "directory": "../../docs/.vitepress/dist",
    // VitePress emits clean URLs (`/reference/cli.html`), so /reference/cli must
    // resolve to it; a miss serves the built 404 page, not an empty 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // workers.dev is DISABLED so the site has exactly one hostname, the one the
  // profile names. The project's own docs are public on their product domain;
  // an installation that wants its docs private puts a Cloudflare Access
  // application in front of this hostname, created in the Zero Trust dashboard
  // by hand (wrangler's token has no Access scope) — Access can only front a
  // real zone hostname, never a workers.dev one.
  "workers_dev": false,
  "routes": [{ "pattern": "{{hostname}}", "custom_domain": true }],
  "observability": { "enabled": true }
}
