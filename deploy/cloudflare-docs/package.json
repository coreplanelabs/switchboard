{
  "name": "switchboard-docs-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --prefix ../../docs run build",
    "deploy": "node ../../scripts/website-maintenance.mjs npm run deploy:site --",
    "verify": "node ../../scripts/website-maintenance.mjs npm run verify:site --",
    "dev": "wrangler dev",
    "tail": "wrangler tail",
    "deploy:site": "npm --prefix ../.. run --silent deploy:gen && npm run build && wrangler deploy",
    "verify:site": "npm --prefix ../.. run --silent deploy:gen && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
