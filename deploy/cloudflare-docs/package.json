{
  "name": "@coreplane/switchboard-docs-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --prefix ../../docs run build",
    "deploy": "npm --prefix ../.. run --silent deploy:gen && npm run build && wrangler deploy",
    "verify": "npm --prefix ../.. run --silent deploy:gen && wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
